{
  "name": "HackerScript",
  "type": "object",
  "properties": {
    "extension_id": {
      "type": "string"
    },
    "script_name": {
      "type": "string",
      "description": "Nome do arquivo (sem extens\u00e3o)"
    },
    "description": {
      "type": "string"
    },
    "player_comp": {
      "type": "string",
      "default": "playerComp"
    },
    "target_comp_name_or_ip": {
      "type": "string",
      "description": "Nome ou IP do computador atacante"
    },
    "config_delay": {
      "type": "number",
      "default": 0
    },
    "commands": {
      "type": "array",
      "description": "Lista de comandos do script",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "delay",
              "connect",
              "openPort",
              "delete",
              "reboot",
              "forkbomb",
              "disconnect",
              "systakeover",
              "clearTerminal",
              "write",
              "writel",
              "hideNetMap",
              "hideRam",
              "hideDisplay",
              "stopMusic",
              "trackseq",
              "instanttrace",
              "flash"
            ]
          },
          "arg1": {
            "type": "string"
          },
          "arg2": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "extension_id",
    "script_name"
  ]
}